# ─── LabDeck · конфигурация чрез environment ────────────────────────────────
# Копирай този файл като .env и редактирай:  cp .env.example .env
# Copy this file to .env and edit it:        cp .env.example .env

# Парола за админ панела. Празно = без защита (само за доверена LAN мрежа!).
# Admin panel password. Empty = no protection (trusted LAN only!).
ADMIN_PASSWORD=

# Порт на хоста, на който се публикува приложението (контейнерът слуша 3000).
# Оцелява при обновяване — смени го само ако портът е зает.
# Host port the app is published on (the container listens on 3000).
# Survives updates — change it only if the port is taken.
LABDECK_PORT=3000

# Часова зона — часовникът, поздравът и логовете.
# Time zone — clock, greeting and logs.
TZ=Europe/Sofia
